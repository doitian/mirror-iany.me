{{- with .CurrentSection }}
<category domain="{{ .Permalink }}">{{ T (print "title." .LinkTitle) | default (.LinkTitle) }}</category>
{{- end }}
{{- with .Params.series -}}
{{- range . -}}
{{- $tag := . -}}
{{- $url := urls.Parse (. | urlize) -}}
{{- $path := $url.Path -}}
{{- with $.Site.GetPage (printf `/series/%s` $path) -}}
<category domain="{{ .Permalink }}">{{ T (print "title." .LinkTitle) | default (.LinkTitle) }}</category>
{{- end -}}
{{- end -}}
{{- end -}}
{{- with .Params.tags -}}
{{- range . -}}
{{- $tag := . -}}
{{- $url := urls.Parse (. | urlize) -}}
{{- $path := $url.Path -}}
{{- with $.Site.GetPage (printf `/tags/%s` $path) -}}
<category domain="{{ .Permalink }}">{{ T (print "title." .LinkTitle) | default (.LinkTitle | humanize | title) }}</category>
{{- end -}}
{{- end -}}
{{- end -}}
