{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ T "recentContentIn" . }}</description>{{ with .Site.LanguageCode }}
    <language>{{.}}</language>{{end}}{{ with .Site.Author.name }}
    <managingEditor>{{.}}</managingEditor>{{end}}{{ with .Site.Author.name }}
    <webMaster>{{.}}</webMaster>{{end}}{{ with .Site.Copyright }}
    <copyright>{{ . | plainify }}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" -}}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{ end -}}

    {{ $posts := .Site.RegularPages }}
    {{- if .Site.Params.hiddenSectionsInHomeRSS -}}
      {{ $posts = where .Site.RegularPages "Section" "not in" .Site.Params.hiddenSectionsInHomeRSS }}
    {{- end }}

    {{ range first 15 $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with .Site.Author.name }}<author>{{.}}</author>{{end}}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | html }}</description>
      {{ partial "rss-categories.xml" . }}
    </item>
    {{ end }}
  </channel>
</rss>
