{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ .Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ T "recentContentIn" .Title }}</description>{{ with .Site.Language.Locale }}
    <language>{{.}}</language>{{end}}{{ with .Site.Params.Author.email }}
    <managingEditor>{{.}}{{ with $.Site.Params.Author.name }} ({{.}}){{end}}</managingEditor>{{end}}{{ with .Site.Params.Author.email }}
    <webMaster>{{.}}{{ with $.Site.Params.Author.name }} ({{.}}){{end}}</webMaster>{{end}}{{ with .Site.Copyright }}
    <copyright>{{ . | plainify }}</copyright>{{end}}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" -}}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}
    {{- end }}
    {{- $pages := .Site.RegularPages }}
    {{- if .Site.Params.mainSections -}}
      {{ $pages = where $pages "Section" "in" .Site.Params.mainSections }}
    {{- end }}
    {{- range first 15 $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ with .Site.Params.Author.email }}<author>{{.}}{{ with $.Site.Params.Author.name }} ({{.}}){{end}}</author>{{end}}
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content |
      replaceRE "(?:&#160;| )<a[^>]*>(?:&#x21a9;&#xfe0e;|↩︎)</a>" "" |
      replaceRE "<a href=\"#[^\"]+.([^>]*>[^<]+</)a>" "<span${1}span>" |
        html }}</description>
      {{ partial "rss-categories.xml" . }}
    </item>
    {{- end }}
  </channel>
</rss>
